# Local Python/Jupyter state
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Inputs are linked from the governed feature pipeline and are not duplicated here.
data/raw/family_freezes/
data/raw/archives/

# Derived registries and analysis results are reproducible and may contain local paths
# or participant-level information. Keep only their directory documentation in Git.
data/derived/registries/*
!data/derived/registries/.gitkeep
outputs/*
!outputs/README.md
!outputs/.gitkeep

# Local review packages and editor/OS files
*.zip
*.log
.DS_Store
Thumbs.db
